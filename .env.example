# Postgres en producción. Para desarrollo local sin servidor: pglite://./.data/dev
DATABASE_URL=pglite://./.data/dev
# Secreto de sesiones (generar con: openssl rand -base64 32)
AUTH_SECRET=
# URL pública de la app
APP_URL=http://localhost:3000
# Clave de la API de Claude (platform.claude.com). Sin clave, la lectura con IA queda desactivada y se carga a mano.
ANTHROPIC_API_KEY=
# Opcionales: lecturas con IA por persona y por día, y modelos
# AI_DAILY_LIMIT=60
# AI_MODEL=claude-sonnet-5-5
# AI_MODEL_FAST=claude-haiku-5-5
# Solo para pruebas locales: IA simulada (nunca en producción)
# AI_FAKE=1
